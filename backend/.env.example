# KALYX Backend Configuration
PORT=8000
HOST=0.0.0.0

# OpenAI API Key for Agentic & RAG operations
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication Config
JWT_SECRET=supersecret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Leave commented or empty to automatically fallback to SQLite (kalyx.db)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kalyx
